---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Favicon from '../components/Favicon.astro';

interface Props {
  title?: string;
}

// Optional per-page <title> override, defaulting to the site-wide title.
// Used by the 404 page (src/pages/404.astro) to set the tab title to "404"
// instead of the generic site name.
const { title = 'Notes on music' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <Favicon />
  </head>
  <body>
    <Header />
    <main>
      <div class="my-internal">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    min-height: 100dvh; /* fallback to 100vh if dvh isn't supported */
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #BAC8B1;
    color: #5A322A;
  }
  main {
    flex-grow: 1;
  }
  .my-internal {
    max-width: 40rem;
    margin: 0 auto;
    padding: 2rem;
  }
  @media (min-width: 768px) {
    .my-internal {
      padding: 3rem 2rem;
    }
  }
</style>
