---
import { getCollection, render } from 'astro:content';
import PagesLayout from '../layouts/Layout.astro';
import CardLayout from '../layouts/CardLayout.astro';
import PageNav from '../components/PageNav.astro';

export async function getStaticPaths() {
	const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
	const cards = (await getCollection('cards')).sort((a, b) => a.data.order - b.data.order);

	return [...pages, ...cards].map((entry) => {
		const sorted = entry.collection === 'cards' ? cards : pages;
		return {
			params: { slug: entry.id },
			props: {
				entry,
				previous: sorted.filter((e) => e.data.order < entry.data.order).at(-1),
				next: sorted.find((e) => e.data.order > entry.data.order),
			},
		};
	});
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const Layout = entry.collection === 'cards' ? CardLayout : PagesLayout;
---

<Layout>
	<main>
		<h1>{entry.data.title}</h1>
		<Content />
		<PageNav
			previous={{ href: previous ? `${base}${previous.id}/` : base, label: previous ? previous.data.title : 'Home' }}
			next={{ href: next ? `${base}${next.id}/` : base, label: next ? next.data.title : 'Home' }}
		/>
	</main>
</Layout>
