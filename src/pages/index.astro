---
import Layout from '../layouts/Layout.astro';

const pages = [
	{ href: 'page-1/', label: 'Page 1' },
	{ href: 'page-2/', label: 'Page 2' },
	{ href: 'page-3/', label: 'Page 3' },
];
---

<Layout>
	<main>
		<h1>My Pages</h1>
		<ul>
			{
				pages.map((page) => (
					<li>
						<a href={page.href}>{page.label}</a>
					</li>
				))
			}
		</ul>
	</main>
</Layout>
