---
// Displays a model of a string.
//
const {
  // We need a
  display_model = 'v1/percent/100',
  string_description = 'v1/desc/a4-acoustic-guitar',
  controller = 'v1',
  sound_model = 'v1',
  string_length = '1',
} = Astro.props;
---

<div class="my-string-v2-wrapper">
  <div
    class="my-string-v2"
    data-display-model={display_model}
    data-description={string_description}
    data-controller={controller}
    data-sound-model={sound_model}
    data-string-length={string_length}
  >
  </div>
</div>

<script>
  import MyDOMElement from '../scripts/dom/MyDOMElement.js';
  import MyStringDisplay
    from '../scripts/components/MyStringDisplay.js';
  import MyStringSound
    from '../scripts/components/MyStringSound.js';
  import MyStringClick
    from '../scripts/components/MyStringClick.js';
  import MyStringCalc
    from '../scripts/components/MyStringCalc.js';

  document.querySelectorAll('.my-string-v2').forEach((element) => {
    if (element.dataset.initialized) {
      return;
    }

    element.dataset.initialized = 'true';

    console.log('About to fetch ' + element.dataset.description);

    new MyDOMElement(element)
      .addComponent(new MyStringDisplay())
      .addComponent(new MyStringSound())
      .addComponent(new MyStringClick())
      .addComponent(new MyStringCalc());
  });
</script>
